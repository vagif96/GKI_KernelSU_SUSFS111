diff --git a/target/linux/qualcommax/dts/ipq5018-archer-ax55-v4.dts b/target/linux/qualcommax/dts/ipq5018-archer-ax55-v4.dts
new file mode 100644
index 0000000..8d47368
--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq5018-archer-ax55-v4.dts
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/*
+ * TP-Link Archer AX55 v4
+ *
+ * Same board as the Archer AX55 v1. Checked against the stock v4 firmware
+ * (1.1.3 Build 20251030): same MP03.3 reference design and DDR CDT, same
+ * NAND partition table, same GPIOs (buttons 25/31, LEDs 10/11/13/18/22/38/39,
+ * USB VBUS 27, RTL8367S reset 33), same 2.5G HSGMII link to the RTL8367S,
+ * same Wi-Fi board IDs (0x24/0x60) and same ART calibration offsets.
+ *
+ * The one thing that differs is the Wi-Fi board data (BDF): v4 ships
+ * retuned BDFs, so it gets its own calibration variant.
+ */
+
+#include "ipq5018-archer-ax55-v1.dts"
+
+/ {
+	model = "TP-Link Archer AX55 v4";
+	compatible = "tplink,archer-ax55-v4", "qcom,ipq5018";
+};
+
+&wifi {
+	qcom,calibration-variant = "TP-Link-Archer-AX55-v4";
+};
+
+&wifi1 {
+	qcom,calibration-variant = "TP-Link-Archer-AX55-v4";
+};
diff --git a/target/linux/qualcommax/image/ipq50xx.mk b/target/linux/qualcommax/image/ipq50xx.mk
index 3848efa..ed0c491 100644
--- a/target/linux/qualcommax/image/ipq50xx.mk
+++ b/target/linux/qualcommax/image/ipq50xx.mk
@@ -359,6 +359,31 @@ endif
 endef
 TARGET_DEVICES += tplink_archer-ax55-v1
 
+define Device/tplink_archer-ax55-v4
+	$(call Device/FitImageLzma)
+	$(call Device/UbiFit)
+	DEVICE_VENDOR := TP-Link
+	DEVICE_MODEL := Archer AX55
+	DEVICE_VARIANT := v4
+	DEVICE_DTS_CONFIG := config@mp03.3
+	SOC := ipq5018
+	BLOCKSIZE := 128k
+	PAGESIZE := 2048
+	IMAGE_SIZE := 43008k
+	NAND_SIZE := 128m
+	DEVICE_PACKAGES := ath11k-firmware-ipq5018-qcn6122 \
+		ipq-wifi-tplink_archer-ax55-v4 \
+		kmod-dsa-rtl8365mb \
+		kmod-usb-ledtrig-usbport
+ifneq ($(CONFIG_TARGET_ROOTFS_INITRAMFS),)
+ifeq ($(IB),)
+	ARTIFACTS := initramfs-factory.ubi
+	ARTIFACT/initramfs-factory.ubi := append-image-stage initramfs-uImage.itb | ubinize-kernel
+endif
+endif
+endef
+TARGET_DEVICES += tplink_archer-ax55-v4
+
 define Device/tplink_eap650-outdoor-v1
 	$(call Device/FitImage)
 	$(call Device/UbiFit)
diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/01_leds b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/01_leds
index 6202221..88e40b5 100644
