diff --git a/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx b/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx
index 7d49a65..fff19bd 100644
--- a/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx
+++ b/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx
@@ -23,6 +23,7 @@ zyxel,scr50axe)
 	;;
 glinet,gl-b3000|\
 tplink,archer-ax55-v1|\
+tplink,archer-ax55-v4|\
 tplink,eap650-outdoor-v1)
 	ubootenv_add_mtd "0:APPSBLENV" "0x0" "0x40000" "0x20000"
 	;;
diff --git a/package/firmware/ipq-wifi/Makefile b/package/firmware/ipq-wifi/Makefile
index a1eb14e..62a817b 100644
--- a/package/firmware/ipq-wifi/Makefile
+++ b/package/firmware/ipq-wifi/Makefile
@@ -13,6 +13,13 @@ PKG_FLAGS:=nonshared
 
 include $(INCLUDE_DIR)/package.mk
 
+# Board files that are not in qca-wireless.git yet (./files/board-*)
+# are copied in next to the fetched ones.
+define Build/Prepare
+	$(call Build/Prepare/Default)
+	$(if $(wildcard ./files/board-*),$(CP) ./files/board-* $(PKG_BUILD_DIR)/)
+endef
+
 define Build/Compile
 endef
 
@@ -94,6 +101,7 @@ ALLWIFIBOARDS:= \
 	spectrum_sax1v1k \
 	tcl_linkhub-hh500v \
 	tplink_archer-ax55-v1 \
+	tplink_archer-ax55-v4 \
 	tplink_archer-c59-v1 \
 	tplink_archer-c6-v2 \
 	tplink_archer-c60-v1 \
@@ -309,6 +317,7 @@ $(eval $(call generate-ipq-wifi-package,skspruce_wia3300-20,SKSpruce WIA3300-20)
 $(eval $(call generate-ipq-wifi-package,spectrum_sax1v1k,Spectrum SAX1V1K))
 $(eval $(call generate-ipq-wifi-package,tcl_linkhub-hh500v,TCL LINKHUB HH500V))
 $(eval $(call generate-ipq-wifi-package,tplink_archer-ax55-v1,TP-Link Archer AX55 v1))
+$(eval $(call generate-ipq-wifi-package,tplink_archer-ax55-v4,TP-Link Archer AX55 v4))
 $(eval $(call generate-ipq-wifi-package,tplink_archer-c59-v1,TP-Link Archer C59 V1))
 $(eval $(call generate-ipq-wifi-package,tplink_archer-c6-v2,TP-Link Archer C6 V2))
