#!/sbin/sh
OUTFD=$2; ZIP=$3
ui_print(){ echo "ui_print $1" >> /proc/self/fd/$OUTFD; echo "ui_print " >> /proc/self/fd/$OUTFD; }
abort(){ ui_print "  !! $1"; exit 1; }
ui_print " "
ui_print "Ryu Core Patch - APPLY (disable signature verification) POCO F5"
ui_print " "
PD=/tmp/ryu; rm -rf "$PD"; mkdir -p "$PD"; unzip -o "$ZIP" -d "$PD" >/dev/null 2>&1
JAR="$PD/services.jar"; [ -f "$JAR" ] || abort "payload missing"
MODE=apply
ORIG_MD5=$(cat "$PD/services_orig_md5" 2>/dev/null)
PATCHED_MD5=$(cat "$PD/services_patched_md5" 2>/dev/null)
. "$PD/twrp_common.sh"
